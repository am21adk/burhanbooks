{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["build.mjs", "lib/**/*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs", "netlify/functions/**/*.mjs", "src/js/**/*.js", "src/admin/**/*.js"]
}
